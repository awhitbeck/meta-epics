record(waveform, "ZCCM:COUNTER:SAMPLES:0") {
    field(DESC, "DMA stream 0 samples")
    field(DTYP, "asynInt32ArrayIn")
    field(INP,  "@asyn($(PORT),0,0)SAMPLES_0")
    field(FTVL, "LONG")
    field(NELM, "1022")
    field(SCAN, "I/O Intr")
}

